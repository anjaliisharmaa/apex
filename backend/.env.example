# Database Configuration
DATABASE_URL=postgresql://apex_user:your_secure_password@localhost:5432/apex_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apex_db
DB_USER=apex_user
DB_PASSWORD=your_secure_password

# Authentication & Security
SECRET_KEY=your-super-secret-key-for-jwt-tokens-make-this-very-long-and-random-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password hashing
BCRYPT_ROUNDS=12

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
DEBUG=false
ENVIRONMENT=development

# CORS Settings (for frontend integration)
FRONTEND_URL=http://localhost:3000

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=uploads/

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/apex.log

# Session Settings
SESSION_EXPIRE_HOURS=24
REMEMBER_ME_EXPIRE_DAYS=30